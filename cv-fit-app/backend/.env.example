NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS -- comma-separated allowed origins (never use "*" with credentials=True)
# Dev: http://127.0.0.1:3000  |  Prod: https://cvfit.com
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000"

# PDF upload size limit in bytes (default 10 MB)
PDF_MAX_SIZE=10485760

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# INFO in production (suppresses DEBUG noise).
LOG_LEVEL=INFO

# LLM Timeout Configurations (in seconds)
LOCAL_LLM_TIMEOUT=15.0
CLOUD_LLM_TIMEOUT=30.0
LLM_MAX_OUTPUT_TOKENS=8192
CV_ANALYSIS_REQUEST_TIMEOUT=300.0
