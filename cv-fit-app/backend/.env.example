NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS -- comma-separated allowed origins (never use "*" with credentials=True)
# Dev: ports 3000/3001  |  Prod: https://cvfit.com
CORS_ALLOWED_ORIGINS="http://127.0.0.1:3000,http://127.0.0.1:3000,http://0.0.0.0:3000,http://127.0.0.1:3001,http://127.0.0.1:3001,http://0.0.0.0:3001"

# PDF upload size limit in bytes (default 10 MB)
PDF_MAX_SIZE=10485760

# Provision this as a PRIVATE object-storage bucket. Do not reuse the public
# source-PDF bucket (`cv`) or enable public object URLs for this bucket.
RAW_EXTRACTION_BUCKET=cv-raw-private

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# INFO in production (suppresses DEBUG noise).
LOG_LEVEL=INFO

# LLM timeout and output configurations (in seconds / tokens)
# Qwen is a remote long-context server. It may need several minutes for a
# large structured response; task-level limits below still bound generation.
LOCAL_LLM_TIMEOUT=15.0
REMOTE_QWEN_TIMEOUT=1200.0
REMOTE_QWEN_MAX_CONCURRENT=1
CLOUD_LLM_TIMEOUT=300.0
LLM_MAX_OUTPUT_TOKENS=8192
QWEN_MAX_OUTPUT_TOKENS=100000
CV_STRUCTURING_MAX_OUTPUT_TOKENS=12000
CV_RANGE_PLAN_SECTION_MAX_OUTPUT_TOKENS=2048
# Keep production on semantic V1. Range V3 is an isolated comparison mapper
# until its source-coverage and compatibility gates are met.
CV_MAPPER_MODE=semantic_v1
CV_MAPPER_V3_ROLLOUT_PERCENT=0
CV_MAPPER_V3_FALLBACK_TO_V1=true
CV_EVALUATION_MAX_OUTPUT_TOKENS=1500
CV_STRUCTURING_MAX_RETRIES=1
CV_ANALYSIS_REQUEST_TIMEOUT=1500.0

# ---------------------------------------------------------------------------
# Security (see audits/security-audit-plan.md, 2026-10-04)
# ---------------------------------------------------------------------------
# Deployment environment. MUST be "production" in prod: it disables mock
# billing and raw LLM prompt logging by default.
ENV=development

# Comma-separated emails allowed to call /api/admin/* (case-insensitive).
# Empty = nobody is an admin.
ADMIN_EMAILS=

# HMAC secret for the one-click manual-payment approval links sent to Telegram.
# Use a long random value that is different from NEXTAUTH_SECRET
# (e.g. `openssl rand -hex 32`). If unset, NEXTAUTH_SECRET is used and a
# warning is logged. Changing it invalidates approval links already sent.
BILLING_APPROVAL_SECRET=

# Fake "mock checkout" routes that add credits without payment. Only works when
# this is explicitly true AND ENV=development. Never enable in production.
ALLOW_MOCK_BILLING=false

# Write LLM prompts (CV text, PII-sanitized) to logs/*-llm-inputs.jsonl and
# logs/prompts/. Off unless set to true, in every environment (the sanitizer only
# masks emails, phones and ID numbers; names and employers remain).
LOG_LLM_INPUTS=false

# Per-user rate limits for expensive endpoints (requests per window).
# Counters live in each process's memory, so N workers allow up to N x the limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LLM_PER_MINUTE=20
RATE_LIMIT_PDF_PER_MINUTE=20
RATE_LIMIT_TTS_PER_MINUTE=30
